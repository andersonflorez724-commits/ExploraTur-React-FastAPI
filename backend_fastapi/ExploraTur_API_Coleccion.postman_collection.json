        {
          "name": "POST /api/auth/login - Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login exitoso - Status 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Retorna token JWT', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    // Guardar token para siguientes requests",
                  "    pm.collectionVariables.set('jwt_token', data.token);",
                  "});",
                  "",
                  "pm.test('Retorna información del usuario con rol', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.usuario).to.have.property('rol', 'Administrador');",
                  "    pm.expect(data.usuario).to.have.property('email', 'admin@exploratur.com');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@exploratur.com\",\n  \"password\": \"Admin1@\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "REQ-10: Login de administrador. Verifica credenciales, genera JWT y retorna token + usuario."
          },
          "response": []
        },
